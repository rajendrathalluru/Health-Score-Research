PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Prefer DATABASE_URL for Supabase/Postgres deployments
DATABASE_URL=postgresql://user:password@host:5432/database

# Or use individual PG* variables instead of DATABASE_URL
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSLMODE=require

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google Health API (replaces legacy Fitbit Web API)
# Client ID/Secret automatically fall back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET if left blank
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3001/api/google-health/callback

USDA_API_KEY=
